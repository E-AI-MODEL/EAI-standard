{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/system-profiles/feature-state.schema.json",
  "title": "EAI System Profile Feature State",
  "description": "Cross-cutting record distinguishing system capability, deployment configuration, observed use and evidence basis without changing the eight-layer system-profile structure.",
  "type": "object",
  "required": ["id", "feature_ref", "capability_status", "deployment_status", "observation_status", "evidence_basis"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "feature_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the feature being described, preferably as a stable profile path or locally stable identifier."
    },
    "capability_status": {
      "enum": ["supported", "unsupported", "unknown"]
    },
    "deployment_status": {
      "enum": ["enabled", "disabled", "not_applicable", "unknown"]
    },
    "observation_status": {
      "enum": ["observed", "not_observed", "not_observable", "unknown"]
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "provider_declared",
          "documentation_verified",
          "deployment_observed",
          "independently_tested",
          "third_party_audit",
          "user_reported",
          "unknown"
        ]
      }
    },
    "scope": {"type": ["string", "null"]},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
