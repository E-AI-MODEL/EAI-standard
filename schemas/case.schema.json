{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/case.schema.json",
  "title": "EAI Standard Case",
  "type": "object",
  "required": ["id", "context", "goal", "actors", "process_position", "claim_type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "process_position": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "model": {"type": ["string", "null"]},
        "label": {"type": "string", "minLength": 1},
        "source_term": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actor", "core_actions"],
        "properties": {
          "actor": {
            "enum": ["teacher_professional", "learner", "multiple_humans"]
          },
          "core_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "status"],
              "properties": {
                "label": {"type": "string"},
                "status": {"enum": ["candidate", "confirmed", "unknown"]},
                "microstructures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "human_execution", "ai_action"],
                    "properties": {
                      "id": {"type": ["string", "null"]},
                      "label": {"type": "string"},
                      "human_execution": {"enum": ["none", "partial", "full", "unknown"]},
                      "ai_action": {"type": "string"},
                      "evidence": {"type": "array", "items": {"type": "string"}},
                      "handback_required": {"type": ["boolean", "null"]},
                      "remediation": {"type": ["string", "null"]}
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "claim_type": {
      "enum": ["current_performance", "professional_judgement", "independent_mastery", "retention", "transfer", "none"]
    },
    "responsibility": {"type": ["string", "null"]},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
