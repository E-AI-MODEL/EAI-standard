{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/case.schema.json",
  "title": "EAI Standard Case",
  "type": "object",
  "required": ["id", "standard_version", "context", "goal", "actors", "process_positions", "claim_type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "standard_version": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "process_positions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/processPosition"}
    },
    "primary_process_position": {"type": ["string", "null"], "minLength": 1},
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actor", "core_actions"],
        "properties": {
          "actor": {"enum": ["teacher_professional", "learner", "multiple_humans"]},
          "core_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "status", "process_position_refs"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "status": {"enum": ["candidate", "confirmed", "unknown"]},
                "skill_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^(TSK|LSK|AIS)-[0-9]{3}$"}
                },
                "process_position_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "microstructures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "human_execution", "ai_actions", "evidence_refs"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^MS-[A-Z0-9-]+$"},
                      "label": {"type": "string", "minLength": 1},
                      "human_execution": {"enum": ["none", "partial", "full", "unknown"]},
                      "ai_actions": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "pattern": "^AIA-[0-9]{2}$"}
                      },
                      "evidence_refs": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}
                      },
                      "handback_required": {"type": ["boolean", "null"]},
                      "remediation_ref": {"type": ["string", "null"], "pattern": "^REM-[0-9]{2}$"}
                    },
                    "additionalProperties": false
                  }
                },
                "protection": {
                  "oneOf": [
                    {"$ref": "protection-assessment.schema.json"},
                    {"type": "null"}
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claim_type": {
      "enum": ["current_performance", "professional_judgement", "independent_mastery", "retention", "transfer", "none"]
    },
    "evidence_items": {
      "type": "array",
      "items": {"$ref": "evidence-item.schema.json"}
    },
    "human_control": {
      "oneOf": [
        {"$ref": "human-control.schema.json"},
        {"type": "null"}
      ]
    },
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extensions": {
      "type": "array",
      "items": {"$ref": "extension.schema.json"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "processPosition": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "label": {"type": "string", "minLength": 1},
        "source_term": {"type": ["string", "null"]},
        "source_element_id": {"type": ["string", "null"]},
        "primary": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
