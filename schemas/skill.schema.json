{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/E-AI-MODEL/EAI-standard/schemas/skill.schema.json",
  "title": "EAI Skill Registry Entry",
  "type": "object",
  "required": ["id", "family", "label", "description"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "applies_to": {
      "type": "array",
      "items": {"enum": ["teacher_professional", "learner", "multiple_humans"]},
      "uniqueItems": true
    },
    "observable_examples": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "microstructure_registry": {"type": "string"},
    "status": {"enum": ["candidate", "stable", "deprecated"]},
    "notes": {"type": ["string", "array"]}
  },
  "additionalProperties": true
}
