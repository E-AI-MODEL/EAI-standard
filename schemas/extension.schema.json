{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/extension.schema.json",
  "title": "EAI Namespaced Extension",
  "type": "object",
  "required": ["namespace", "data"],
  "properties": {
    "namespace": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
      "description": "Globally unique URI namespace controlled by the extension publisher. The pattern makes URI-scheme presence an asserted structural constraint even in validators that treat JSON Schema format as annotation."
    },
    "version": {"type": ["string", "null"]},
    "schema": {"type": ["string", "null"], "format": "uri"},
    "data": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
