{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/protection-assessment.schema.json",
  "title": "EAI Protection Assessment",
  "type": "object",
  "required": ["dimensions"],
  "properties": {
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "status", "bases"],
        "properties": {
          "requirement_id": {
            "enum": ["PRT-01", "PRT-02", "PRT-03", "PRT-04", "PRT-05", "PRT-06", "PRT-07", "PRT-08"]
          },
          "status": {
            "enum": ["required", "strongly_recommended", "recommended", "conditional", "delegable", "unknown"]
          },
          "condition": {"type": ["string", "null"]},
          "rationale": {"type": ["string", "null"]},
          "bases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "reference", "applicability", "bindingness"],
              "properties": {
                "type": {
                  "enum": ["eai_normative_rule", "law_or_regulation", "scientific_evidence", "recognised_framework", "professional_standard", "institutional_rule"]
                },
                "reference": {"type": "string", "minLength": 1},
                "authority": {"type": ["string", "null"]},
                "jurisdiction": {"type": ["string", "null"]},
                "source_uri": {"type": ["string", "null"], "format": "uri"},
                "applicability": {
                  "enum": ["applicable", "potentially_applicable", "not_applicable", "unknown"]
                },
                "bindingness": {
                  "enum": ["eai_normative", "legally_binding", "locally_binding", "non_binding", "evidence_only", "unknown"]
                },
                "support_relation": {
                  "enum": ["direct_support", "conceptual_alignment", "boundary_support", "context_support"]
                },
                "notes": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
