{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/adapter.schema.json",
  "title": "EAI Source-Preserving Model Adapter",
  "type": "object",
  "required": ["id", "model_name", "source_reference", "source_elements"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "standard_version": {"type": ["string", "null"]},
    "artifact_version": {"type": ["string", "null"]},
    "model_name": {"type": "string", "minLength": 1},
    "model_family": {"type": ["string", "null"]},
    "source_reference": {"type": "string", "minLength": 1},
    "source_version": {"type": ["string", "null"]},
    "source_license": {"type": ["string", "null"]},
    "source_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_type", "source_label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["process_position", "action", "principle", "relation", "evidence_point", "other"]},
          "source_label": {"type": "string", "minLength": 1},
          "source_definition": {"type": ["string", "null"]},
          "source_order": {"type": ["number", "string", "null"]},
          "source_relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "target"],
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "target": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "source_metadata": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_element_id", "mapping_type", "eai_targets"],
        "properties": {
          "source_element_id": {"type": "string", "minLength": 1},
          "mapping_type": {"enum": ["equivalent", "partial_overlap", "broader_than", "narrower_than", "related", "none"]},
          "eai_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "id_or_label"],
              "properties": {
                "type": {"enum": ["process_position", "skill", "microstructure", "core_human_action", "ai_action", "evidence_point", "relation"]},
                "id_or_label": {"type": "string", "minLength": 1},
                "actor": {"enum": ["teacher_professional", "learner", "multiple_humans", null]}
              },
              "additionalProperties": false
            }
          },
          "rationale": {"type": ["string", "null"]},
          "confidence": {"enum": ["high", "medium", "low", "unknown", null]}
        },
        "additionalProperties": false
      }
    },
    "unmapped_source_elements": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Source element IDs deliberately retained without an EAI mapping."
    },
    "extensions": {
      "type": "array",
      "items": {"$ref": "extension.schema.json"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
