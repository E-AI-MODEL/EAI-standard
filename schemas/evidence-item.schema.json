{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/evidence-item.schema.json",
  "title": "EAI Human Evidence Item",
  "type": "object",
  "required": ["id", "evidence_type", "observation", "claim_types"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "evidence_type": {"type": "string", "pattern": "^EV-[0-9]{2}$"},
    "source_actor": {
      "enum": ["teacher_professional", "learner", "multiple_humans", "external_observer", "system_trace", "unknown"]
    },
    "observation": {"type": "string", "minLength": 1},
    "interpretation": {"type": ["string", "null"]},
    "claim_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["current_performance", "professional_judgement", "independent_mastery", "retention", "transfer", "none"]
      }
    },
    "support_conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "independence": {
      "enum": ["independent", "supported", "mixed", "not_applicable", "unknown"]
    },
    "collected_at": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
