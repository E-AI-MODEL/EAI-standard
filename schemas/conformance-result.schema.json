{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/conformance-result.schema.json",
  "title": "EAI Conformance Result",
  "type": "object",
  "required": ["profile", "standard_version", "conformance", "information_state", "diagnostics"],
  "properties": {
    "profile": {"type": "string", "minLength": 1},
    "standard_version": {"type": "string", "minLength": 1},
    "conformance": {"enum": ["conformant", "non_conformant"]},
    "information_state": {"enum": ["complete", "contains_unknowns", "incomplete"]},
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "diagnostic.schema.json"}
    },
    "retained_unknowns": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "extensions": {
      "type": "array",
      "items": {"$ref": "extension.schema.json"}
    }
  },
  "additionalProperties": false
}
