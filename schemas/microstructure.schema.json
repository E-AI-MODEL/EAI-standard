{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/schemas/microstructure.schema.json",
  "title": "EAI Microstructure Registry Item",
  "type": "object",
  "required": ["id", "label", "description"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "group": {"type": ["string", "null"]},
    "actor": {"enum": ["teacher_professional", "learner", "multiple_humans", null]},
    "ai_takeover_risk": {"type": ["string", "null"]},
    "observable_signal": {"type": ["string", "null"]},
    "diagnostic_prompt": {"type": ["string", "null"]},
    "prevention_hint": {"type": ["string", "null"]},
    "remediation_hint": {"type": ["string", "null"]},
    "evidence_types": {"type": "array", "items": {"type": "string"}},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "array",
      "items": {"$ref": "extension.schema.json"}
    }
  },
  "additionalProperties": false
}
