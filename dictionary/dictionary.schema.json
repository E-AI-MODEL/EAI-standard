{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/EAI-standard/dictionary/dictionary.schema.json",
  "title": "EAI Dictionary (non-normative)",
  "type": "object",
  "required": [
    "dictionary",
    "status",
    "author",
    "positioning_model",
    "entries",
    "standard_version"
  ],
  "properties": {
    "dictionary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "non_normative"
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "source_editions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language",
          "title"
        ],
        "properties": {
          "language": {
            "enum": [
              "en",
              "nl"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false
      }
    },
    "positioning_model": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "standard_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "en",
        "nl"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "nl": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "position": {
      "enum": [
        "education_native",
        "education_led",
        "shared",
        "technology_led",
        "technology_native"
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "term",
        "label",
        "position",
        "why",
        "practical_use"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "term": {
          "$ref": "#/$defs/text"
        },
        "nl_translation": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": [
            "eai_term",
            "eai_formalisation",
            "eai_meaning",
            "common_term"
          ]
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "object",
              "required": [
                "human",
                "system"
              ],
              "properties": {
                "human": {
                  "$ref": "#/$defs/position"
                },
                "system": {
                  "$ref": "#/$defs/position"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "definition": {
          "$ref": "#/$defs/text"
        },
        "meanings": {
          "type": "object",
          "required": [
            "human",
            "system"
          ],
          "properties": {
            "human": {
              "$ref": "#/$defs/text"
            },
            "system": {
              "$ref": "#/$defs/text"
            }
          },
          "additionalProperties": false
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "distinction": {
          "$ref": "#/$defs/text"
        },
        "practical_use": {
          "$ref": "#/$defs/text"
        },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
          }
        },
        "eai_refs": {
          "type": "object",
          "properties": {
            "proposal_concepts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "definitions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "identifiers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(EV|AIA|REM|MS|TSK|LSK|AIS|POS)-[A-Z0-9-]+$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "required": [
            "definition"
          ],
          "not": {
            "required": [
              "meanings"
            ]
          }
        },
        {
          "required": [
            "meanings"
          ],
          "not": {
            "required": [
              "definition"
            ]
          }
        }
      ],
      "if": {
        "properties": {
          "position": {
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "meanings"
        ]
      },
      "else": {
        "required": [
          "definition"
        ]
      },
      "additionalProperties": false
    }
  }
}
